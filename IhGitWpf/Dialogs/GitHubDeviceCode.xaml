<UserControl x:Class="IhGitWpf.Dialogs.GitHubDeviceCode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:materialDesignConverters="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
             xmlns:local="clr-namespace:IhGitWpf.Dialogs"
             xmlns:vm="clr-namespace:IhGitWpf.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GitHubDeviceCodeDialogViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid Margin="16"
          RowDefinitions="* * * *">
        <TextBlock HorizontalAlignment="Center"
                   Grid.Row="0"
                   Text="GitHub authorization required"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
        <TextBlock HorizontalAlignment="Center"
                   Grid.Row="1"
                   Margin="0 6"
                   Text="Enter the displayed device code in GitHub to authorize IhGit"
                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
        <StackPanel Grid.Row="2"
                    Margin="0 20"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBlock Text="{Binding DeviceCode}"
                       Style="{StaticResource MaterialDesignHeadline2TextBlock}"
                       VerticalAlignment="Center" />
            <Button Content="{materialDesign:PackIcon Kind=ContentCopy}"
                    Command="{Binding CopyCodeCommand}"
                    CommandParameter="{Binding DeviceCode}"
                    Style="{StaticResource MaterialDesignFlatButton}" />
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBlock Text="Enter code here: "
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding Url}"
                       VerticalAlignment="Center"
                       TextDecorations="Underline">
                <TextBlock.InputBindings>
                    <MouseBinding Command="{Binding OpenUrlCommand}"
                                  MouseAction="LeftClick" />
                </TextBlock.InputBindings>
            </TextBlock>
            <Button Content="{materialDesign:PackIcon Kind=ContentCopy}"
                    Command="{Binding CopyCodeCommand}"
                    CommandParameter="{Binding Url}"
                    Style="{StaticResource MaterialDesignFlatButton}" />
        </StackPanel>
    </Grid>
</UserControl>
